{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "scss",
      "camelcase": "SCSS",
      "title": "SCSS",
      "scope": "source.scss",
      "path": ".",
      "file-types": [
        "scss"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "injection-regex": "^scss$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for current SCSS syntax (module system, maps, control flow)",
    "authors": [
      {
        "name": "Amaan Qureshi",
        "email": "amaanq12@gmail.com"
      },
      {
        "name": "M. Reifschneider"
      }
    ],
    "links": {
      "repository": "https://github.com/meloncholera/tree-sitter-scss-modern"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false
  }
}
